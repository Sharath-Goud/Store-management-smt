        document.addEventListener("DOMContentLoaded", function () {

            const searchInput =
                document.getElementById("inventorySearch");

            const clearButton =
                document.getElementById("clearSearch");

            const rows =
                Array.from(
                    document.querySelectorAll(".inventory-row")
                );

            const noSearchResults =
                document.getElementById("noSearchResults");

            const pagination =
                document.getElementById("inventoryPagination");

            const paginationInfo =
                document.getElementById("inventoryPaginationInfo");

            const pagesContainer =
                document.getElementById("inventoryPages");

            const previousButton =
                document.getElementById("inventoryPrev");

            const nextButton =
                document.getElementById("inventoryNext");


            let safetyFilter = "";

            let currentPage = 1;

            const recordsPerPage = 10;


            if (!searchInput) {
                return;
            }

            function getFilteredRows() {

                const searchText =
                    searchInput.value
                        .trim()
                        .toLowerCase();


                return rows.filter(function (row) {

                    const partNumber =
                        (
                            row.getAttribute("data-part-number") || ""
                        ).toLowerCase();


                    const itemName =
                        (
                            row.getAttribute("data-item-name") || ""
                        ).toLowerCase();


                    const matchesSearch =
                        partNumber.includes(searchText) ||
                        itemName.includes(searchText);


                    const matchesSafety =
                        safetyFilter === "" ||
                        row.getAttribute("data-safety") === safetyFilter;


                    return matchesSearch && matchesSafety;

                });

            }

            function renderPagination(totalRecords) {

                const totalPages =
                    Math.ceil(
                        totalRecords / recordsPerPage
                    );


                pagesContainer.innerHTML = "";

                if (totalPages <= 1) {

                    pagination.style.display = "none";

                    return;
                }

                pagination.style.display = "flex";

                previousButton.disabled =
                    currentPage === 1;

                nextButton.disabled =
                    currentPage === totalPages;

                if (totalPages <= 7) {

                    for (
                        let page = 1;
                        page <= totalPages;
                        page++
                    ) {

                        createPageButton(page);

                    }

                }
                else {

                    createPageButton(1);


                    if (currentPage <= 4) {

                        createPageButton(2);
                        createPageButton(3);
                        createPageButton(4);
                        createPageButton(5);

                        createDots();

                        createPageButton(totalPages);

                    }
                    else if (
                        currentPage >= totalPages - 3
                    ) {

                        createDots();

                        createPageButton(totalPages - 4);
                        createPageButton(totalPages - 3);
                        createPageButton(totalPages - 2);
                        createPageButton(totalPages - 1);
                        createPageButton(totalPages);

                    }
                    else {

                        createDots();

                        createPageButton(currentPage - 1);
                        createPageButton(currentPage);
                        createPageButton(currentPage + 1);

                        createDots();

                        createPageButton(totalPages);

                    }

                }

                function createPageButton(page) {

                    const button =
                        document.createElement("button");

                    button.type = "button";

                    button.className =
                        "pagination-number" +
                        (
                            page === currentPage
                                ? " active"
                                : ""
                        );

                    button.textContent = page;

                    button.addEventListener(
                        "click",
                        function () {

                            showPage(page);

                        }
                    );

                    pagesContainer.appendChild(button);

                }

                function createDots() {

                    const dots =
                        document.createElement("span");

                    dots.className =
                        "pagination-dots";

                    dots.textContent = "…";

                    pagesContainer.appendChild(dots);

                }

            }

            function showPage(page) {

                const filteredRows =
                    getFilteredRows();


                const totalRecords =
                    filteredRows.length;


                const totalPages =
                    Math.ceil(
                        totalRecords / recordsPerPage
                    );

                if (totalPages === 0) {

                    currentPage = 1;

                }
                else {

                    currentPage =
                        Math.max(
                            1,
                            Math.min(page, totalPages)
                        );

                }


                const startIndex =
                    (currentPage - 1) *
                    recordsPerPage;


                const endIndex =
                    startIndex +
                    recordsPerPage;

                rows.forEach(function (row) {

                    row.style.display = "none";

                });

                filteredRows.forEach(
                    function (row, index) {

                        if (
                            index >= startIndex &&
                            index < endIndex
                        ) {

                            row.style.display = "";

                        }

                    }
                );

                if (noSearchResults) {

                    if (totalRecords === 0) {

                        noSearchResults.style.display =
                            "table-row";

                    }
                    else {

                        noSearchResults.style.display =
                            "none";

                    }

                }

                if (clearButton) {

                    clearButton.style.display =
                        searchInput.value.trim().length > 0
                            ? "block"
                            : "none";

                }

                if (paginationInfo) {

                    if (totalRecords === 0) {

                        paginationInfo.textContent =
                            "Showing 0 of 0 items";

                    }
                    else {

                        const showingFrom =
                            startIndex + 1;

                        const showingTo =
                            Math.min(
                                endIndex,
                                totalRecords
                            );


                        paginationInfo.textContent =
                            `Showing ${showingFrom}–${showingTo} of ${totalRecords} items`;

                    }

                }

                renderPagination(totalRecords);

            }

            searchInput.addEventListener(
                "input",
                function () {

                    currentPage = 1;

                    showPage(1);

                }
            );

            if (clearButton) {

                clearButton.addEventListener(
                    "click",
                    function () {

                        searchInput.value = "";

                        currentPage = 1;

                        showPage(1);

                        searchInput.focus();

                    }
                );

            }

            window.filterBySafety =
                function (status) {

                    safetyFilter = status;

                    searchInput.value = "";

                    currentPage = 1;

                    showPage(1);


                    const inventoryCard =
                        document.querySelector(
                            ".inventory-card"
                        );


                    if (inventoryCard) {

                        inventoryCard.scrollIntoView({
                            behavior: "smooth",
                            block: "start"
                        });

                    }

                };

            const notSafeCard =
                document.getElementById(
                    "notSafeSummaryCard"
                );


            if (notSafeCard) {

                notSafeCard.addEventListener(
                    "click",
                    function () {

                        window.filterBySafety(
                            "not-safe"
                        );

                    }
                );


                notSafeCard.addEventListener(
                    "keydown",
                    function (event) {

                        if (
                            event.key === "Enter" ||
                            event.key === " "
                        ) {

                            event.preventDefault();

                            window.filterBySafety(
                                "not-safe"
                            );

                        }

                    }
                );

            }

            if (previousButton) {

                previousButton.addEventListener(
                    "click",
                    function () {

                        if (currentPage > 1) {

                            showPage(
                                currentPage - 1
                            );

                        }

                    }
                );

            }

            if (nextButton) {

                nextButton.addEventListener(
                    "click",
                    function () {

                        const filteredRows =
                            getFilteredRows();


                        const totalPages =
                            Math.ceil(
                                filteredRows.length /
                                recordsPerPage
                            );


                        if (
                            currentPage <
                            totalPages
                        ) {

                            showPage(
                                currentPage + 1
                            );

                        }

                    }
                );

            }

            showPage(1);

        });

        document.addEventListener("DOMContentLoaded", function () {

            const historyList =
                document.getElementById("historyList");

            const pagination =
                document.getElementById("historyPagination");

            const pagesContainer =
                document.getElementById("historyPages");

            const previousButton =
                document.getElementById("historyPrev");

            const nextButton =
                document.getElementById("historyNext");


            if (!historyList || !pagination) {
                return;
            }


            const historyItems =
                Array.from(
                    historyList.querySelectorAll(".history-item")
                );


            const recordsPerPage = 10;

            const totalRecords =
                historyItems.length;

            const totalPages =
                Math.ceil(totalRecords / recordsPerPage);


            let currentPage = 1;

            if (totalPages <= 1) {

                pagination.style.display = "none";

                historyItems.forEach(function (item) {
                    item.classList.remove("history-hidden");
                });

                return;
            }

            function showPage(page) {

                currentPage = page;


                const startIndex =
                    (currentPage - 1) * recordsPerPage;


                const endIndex =
                    startIndex + recordsPerPage;


                historyItems.forEach(function (item, index) {

                    if (
                        index >= startIndex &&
                        index < endIndex
                    ) {

                        item.classList.remove("history-hidden");

                    }
                    else {

                        item.classList.add("history-hidden");

                    }

                });


                renderPagination();

                previousButton.disabled =
                    currentPage === 1;

                nextButton.disabled =
                    currentPage === totalPages;

                historyList.scrollIntoView({
                    behavior: "smooth",
                    block: "start"
                });

            }

            function renderPagination() {

                pagesContainer.innerHTML = "";

                if (totalPages <= 7) {

                    for (
                        let page = 1;
                        page <= totalPages;
                        page++
                    ) {

                        createPageButton(page);

                    }

                    return;
                }

                createPageButton(1);


                if (currentPage <= 4) {

                    createPageButton(2);
                    createPageButton(3);
                    createPageButton(4);
                    createPageButton(5);

                    createDots();

                    createPageButton(totalPages);

                }

                else if (
                    currentPage >= totalPages - 3
                ) {

                    createDots();

                    createPageButton(totalPages - 4);
                    createPageButton(totalPages - 3);
                    createPageButton(totalPages - 2);
                    createPageButton(totalPages - 1);
                    createPageButton(totalPages);

                }

                else {

                    createDots();

                    createPageButton(
                        currentPage - 1
                    );

                    createPageButton(
                        currentPage
                    );

                    createPageButton(
                        currentPage + 1
                    );

                    createDots();

                    createPageButton(totalPages);

                }

            }

            function createPageButton(page) {

                const button =
                    document.createElement("button");


                button.type = "button";

                button.className =
                    "pagination-number";


                button.textContent =
                    page;


                if (page === currentPage) {

                    button.classList.add("active");

                }


                button.addEventListener(
                    "click",
                    function () {

                        showPage(page);

                    }
                );


                pagesContainer.appendChild(button);

            }

            function createDots() {

                const dots =
                    document.createElement("span");


                dots.className =
                    "pagination-dots";


                dots.textContent =
                    "…";


                pagesContainer.appendChild(dots);

            }

            previousButton.addEventListener(
                "click",
                function () {

                    if (currentPage > 1) {

                        showPage(
                            currentPage - 1
                        );

                    }

                }
            );

            nextButton.addEventListener(
                "click",
                function () {

                    if (
                        currentPage < totalPages
                    ) {

                        showPage(
                            currentPage + 1
                        );

                    }

                }
            );

            showPage(1);

        });


        function openImagePopup(imageSrc, imageName) {
            const popup = document.getElementById("imagePopup");
            const popupImage = document.getElementById("popupImage");
            const caption = document.getElementById("popupImageCaption");

            if (!popup || !popupImage) return;

            popupImage.src = imageSrc;
            popupImage.alt = imageName || "Product image preview";

            if (caption) {
                caption.textContent = imageName || "";
            }

            popup.classList.add("show");
            document.body.style.overflow = "hidden";
        }

        function closeImagePopup(event) {
            if (event) {
                event.stopPropagation();
            }

            const popup = document.getElementById("imagePopup");

            if (!popup) return;

            popup.classList.remove("show");
            document.body.style.overflow = "";
        }

        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape") {
                closeImagePopup();
            }
        });


    </script>

