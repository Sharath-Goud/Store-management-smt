            btn.style.backgroundColor = '#fee2e2';
            btn.style.color = '#dc2626';

            setTimeout(function () {

                btn.dataset.confirmed = '';

                btn.innerHTML = '🗑 Delete';

                btn.style.backgroundColor = '';
                btn.style.color = '';

            }, 3000);

