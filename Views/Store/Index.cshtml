
@model StoreViewModel

@{
    ViewData["Title"] = "Inventory";
}

@if (TempData["Success"] != null)
{
    <div class="toast-message toast-success">
        <div class="toast-icon">✓</div>
        <div>
            <strong>Success</strong>
            <span>@TempData["Success"]</span>
        </div>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="toast-message toast-error">
        <div class="toast-icon">!</div>
        <div>
            <strong>Error</strong>
            <span>@TempData["Error"]</span>
        </div>
    </div>
}


<div class="inventory-container">

    <div class="inventory-header">

        <div class="header-left">

            <div class="header-icon">
                📦
            </div>

            <div>
                <div class="breadcrumb">
                    Store Management
                    <span>›</span>
                    Inventory
                </div>

                <h1>Inventory</h1>

                <p>
                    Manage stock levels, item information and transaction history
                </p>
            </div>

        </div>


        <div class="header-right">
            <a asp-controller="Store"
               asp-action="AddItem"
               asp-route-brandId="@ViewBag.BrandId"
               class="add-item-btn">

                <span class="plus-icon">+</span>
                Add Item

            </a>
        </div>

    </div>


    <div class="summary-grid">

        <div class="summary-card">

            <div class="summary-content">

                <span class="summary-label">
                    Total Items
                </span>

                <strong class="summary-value">
                    @(Model.Items?.Count() ?? 0)
                </strong>

                <span class="summary-description">
                </span>

            </div>

            <div class="summary-icon blue">
                📦
            </div>

        </div>


        <div class="summary-card">

            <div class="summary-content">

                <span class="summary-label">
                    Total Stock
                </span>

                <strong class="summary-value">
                    @(Model.Items?.Sum(x => x.Quantity) ?? 0)
                </strong>

                <span class="summary-description">
                    Current available quantity
                </span>

            </div>

            <div class="summary-icon green">
                📊
            </div>

        </div>



        <!-- NOT SAFE SUMMARY CARD -->
        <div class="summary-card not-safe-summary"
             id="notSafeSummaryCard"
             role="button"
             tabindex="0"
             title="Click to view all Not Safe items">

            <div class="summary-content">
                <span class="summary-label">Not Safe</span>

                <strong class="summary-value">
                    @(Model.Items?.Count(x =>
                                        x.LifeTimeDays.HasValue &&
                                        x.LeadTimeDays.HasValue &&
                                        x.LifeTimeDays.Value < x.LeadTimeDays.Value) ?? 0)
                </strong>

                <span class="summary-description">
                    Items requiring attention
                </span>
            </div>

            <div class="summary-icon"
                 style="background:#fff1f2; color:#be123c;">
                ⚠
            </div>
        </div>



        <div class="summary-card">

            <div class="summary-content">

                <span class="summary-label">
                    Transactions
                </span>

                <strong class="summary-value">
                    @(Model.History?.Count() ?? 0)
                </strong>

                <span class="summary-description">
                    Recorded stock movements
                </span>

            </div>

            <div class="summary-icon purple">
                ↔
            </div>

        </div>

    </div>

    <section class="inventory-card">

        <div class="card-header">

            <div>

                <h2>
                    Inventory Items
                </h2>

                <p>
                    View and manage your current stock
                </p>

            </div>


            <div class="search-container">

                <div class="search-form">

                    <span class="search-icon">
                        🔍
                    </span>

                    <input id="inventorySearch"
                           type="text"
                           value="@Model.Search"
                           placeholder="Search by Part Number or Item Name..."
                           autocomplete="off" />

                    <button type="button"
                            id="clearSearch"
                            class="search-clear"
                            title="Clear search"
                            style="display:none;">
                        ×
                    </button>

                </div>

            </div>

        </div>



        <div class="table-container">
            <table class="inventory-table">
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Part Number</th>
                        <th>Model Number</th>
                        <th>Project Code</th>
                        <th>Description</th>
                        <th>Total Quantity</th>
                        <th>Good Quantity</th>
                        <th>Bad Quantity</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {

                            <tr class="inventory-row"
                                data-part-number="@item.PartNumber"
                                data-item-name="@item.ItemName"
                                data-safety="@(
                                item.LifeTimeDays.HasValue &&
                                item.LeadTimeDays.HasValue
                                    ? (item.LifeTimeDays.Value < item.LeadTimeDays.Value
                                        ? "not-safe"
                                        : item.LifeTimeDays.Value > item.LeadTimeDays.Value
                                            ? "safe"
                                            : "review")
                                    : "pending")">


                                <td>
                                    <div class="product-image-wrapper">
                                        @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                                        {
                                            <img src="@item.ImagePath"
                                                 class="product-image clickable-product-image"
                                                 alt="@item.ItemName"
                                                 title="Click to view full image"
                                                 onclick="openImagePopup(this.src, this.alt)" />
                                        }
                                        else
                                        {
                                            <div class="no-image">📦</div>
                                        }
                                    </div>
                                </td>


                        <!-- Part Number -->
                        <td>
                            <div class="part-number">@item.PartNumber</div>
                        </td>

                        <!-- Model Number -->
                        <td>
                            @(string.IsNullOrWhiteSpace(item.ModelNumber)
                                                        ? "—"
                                                        : item.ModelNumber)
                                                                       </td>

                        <!-- Project Code -->
                        <td>
                            @(string.IsNullOrWhiteSpace(item.ProjectCode)
                                                        ? "—"
                                                        : item.ProjectCode)
                        </td>

                                <!-- Item Name -->
                                <td>
                                    <div class="item-info">
                                        <strong>@item.ItemName</strong>
                                    </div>
                                </td>

                                <!-- Total Quantity = Quantity + StockOut -->
                                <td>
                                    <span class="quantity-badge total">
                                        @(item.Quantity + item.StockOut)
                                    </span>
                                </td>

                                <!-- Good Quantity = Quantity -->
                                <td>
                                    <span class="quantity-badge good">
                                        @item.Quantity
                                    </span>
                                </td>

                                <!-- Bad Quantity (NG) = StockOut -->
                                <td>
                                    <span class="quantity-badge bad">
                                        @item.StockOut
                                    </span>
                                </td>


                                <!-- Safety Status -->
                                <td class="safety-cell">
                            @if (item.LifeTimeDays.HasValue &&
                                                        item.LeadTimeDays.HasValue)
                                    {
                                        if (item.LifeTimeDays.Value > item.LeadTimeDays.Value)
                                        {
                                            <span class="safety-badge safe">
                                                <span class="safety-dot"></span>
                                                Safe
                                            </span>
                                        }
                                        else if (item.LifeTimeDays.Value < item.LeadTimeDays.Value)
                                        {

                                            <button type="button"
                                                    class="safety-badge not-safe safety-filter-button"
                                                    onclick="filterBySafety('not-safe')">
                                                <span class="safety-dot"></span>
                                                Not Safe
                                            </button>

                                        }
                                        else
                                        {
                                            <span class="safety-badge review">
                                                Review
                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="safety-badge pending">
                                            Pending
                                        </span>
                                    }
                                </td>

                            </tr>
                                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9">
                                <div class="empty-state">
                                    <div class="empty-icon">📦</div>
                                    <h3>No inventory items found</h3>
                                    <p>There are no items matching your search.</p>
                                </div>
                            </td>
                        </tr>
                    }

                    <!-- Search result message -->
                    <tr id="noSearchResults" style="display: none;">
                        <td colspan="9">
                            <div class="empty-state">
                                <div class="empty-icon">🔍</div>
                                <h3>No matching items found</h3>
                                <p>No Part Number or Item Name matches your search.</p>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
         <!-- Inventory Pagination -->
        <div id="inventoryPagination" class="inventory-pagination">

            <div class="inventory-pagination-info">
                <span id="inventoryPaginationInfo"></span>
            </div>

            <div class="inventory-pagination-controls">

                <button type="button"
                        id="inventoryPrev"
                        class="pagination-btn">
                    ‹ Previous
                </button>

                <div id="inventoryPages"
                     class="pagination-pages">
                </div>

                <button type="button"
                        id="inventoryNext"
                        class="pagination-btn">
                    Next ›
                </button>

            </div>

        </div>

    </section>

    
</div>

<!-- Product Image Popup -->
<div id="imagePopup" class="image-popup"
     onclick="closeImagePopup(event)">

    <button type="button"
            class="image-popup-close"
            onclick="closeImagePopup(event)"
            aria-label="Close image">
        &times;
    </button>

    <div class="image-popup-content"
         onclick="event.stopPropagation()">

        <img id="popupImage"
             src=""
             alt="Product image preview" />

        <div id="popupImageCaption"
             class="image-popup-caption"></div>
    </div>
</div>


<style>

    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        padding: 0;
    }

    body {
        background: #f5f7fb;
        color: #172033;
    }

    .inventory-container {
        width: 100%;
        max-width: none;
        margin: 0 auto;
    }

    .inventory-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .header-right {
        display: flex;
        align-items: center;
    }

    .header-icon {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        color: #ffffff;
        font-size: 27px;
        box-shadow: 0 10px 25px rgba(37, 99, 235, 0.22);
    }

    .breadcrumb {
        margin-bottom: 5px;
        font-size: 13px;
        color: #8a94a6;
    }

        .breadcrumb span {
            padding: 0 6px;
        }

    .inventory-header h1 {
        margin: 0;
        font-size: 32px;
        font-weight: 800;
        letter-spacing: -0.5px;
    }

    .inventory-header p {
        margin: 5px 0 0;
        color: #7b8494;
        font-size: 14px;
    }

    .add-item-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 13px 20px;
        border-radius: 12px;
        text-decoration: none;
        color: #ffffff;
        background: #2563eb;
        font-weight: 700;
        box-shadow: 0 8px 20px rgba(37, 99, 235, 0.22);
        transition: all 0.2s ease;
    }

        .add-item-btn:hover {
            color: #ffffff;
            transform: translateY(-2px);
            background: #1d4ed8;
        }

    .plus-icon {
        font-size: 21px;
        line-height: 1;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 25px;
    }

    .summary-card {
        background: #ffffff;
        border: 1px solid #e8ecf3;
        border-radius: 18px;
        padding: 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 5px 20px rgba(15, 23, 42, 0.04);
        transition: all 0.2s ease;
    }

        .summary-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(15, 23, 42, 0.07);
        }

    .summary-content {
        display: flex;
        flex-direction: column;
    }

    .summary-label {
        color: #7b8494;
        font-size: 13px;
        font-weight: 600;
    }

    .summary-value {
        margin-top: 5px;
        font-size: 29px;
        font-weight: 800;
        color: #172033;
    }

    .summary-description {
        margin-top: 4px;
        font-size: 12px;
        color: #a0a7b4;
    }

    .summary-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
    }

        .summary-icon.blue {
            background: #eff6ff;
        }

        .summary-icon.green {
            background: #ecfdf5;
        }

        .summary-icon.orange {
            background: #fff7ed;
        }

        .summary-icon.purple {
            background: #f5f3ff;
        }

    .inventory-card {
        background: #ffffff;
        border: 1px solid #e7ebf2;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(15, 23, 42, 0.05);
    }

    .card-header {
        padding: 24px 26px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #edf0f5;
    }

        .card-header h2 {
            margin: 0;
            font-size: 19px;
            font-weight: 750;
        }

        .card-header p {
            margin: 5px 0 0;
            color: #8992a2;
            font-size: 13px;
        }

    .search-container {
        width: auto;
    }

    .search-form {
        height: 44px;
        width: 390px;
        display: flex;
        align-items: center;
        background: #f7f9fc;
        border: 1px solid #e1e6ee;
        border-radius: 11px;
        overflow: hidden;
        transition: all 0.2s ease;
    }

        .search-form:focus-within {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
        }

    .search-icon {
        padding-left: 13px;
        font-size: 14px;
    }

    .search-form input {
        flex: 1;
        height: 100%;
        border: 0;
        outline: 0;
        background: transparent;
        padding: 0 10px;
        font-size: 13px;
        color: #1e293b;
        margin-top: 3px;
    }

        .search-form input::placeholder {
            color: #9aa3b2;
        }

    .search-form button {
        height: 100%;
        border: 0;
        padding: 0 17px;
        background: #172033;
        color: #ffffff;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s ease;
    }

        .search-form button:hover {
            background: #2563eb;
        }

    .search-clear {
        color: #8992a2;
        text-decoration: none;
        font-size: 20px;
        padding: 0 8px;
        line-height: 1;
    }

        .search-clear:hover {
            color: #ef4444;
        }



    /* Table scrolls independently of the page */
    .table-container {
        display: block;
        width: 100%;
        max-width: 100%;
        overflow-x: auto;
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
        scrollbar-color: #94a3b8 #edf2f7;
    }

    /* Use the available screen width, expanding when necessary */
    .inventory-table {
        width: 100%;
        min-width: 1250px;
        table-layout: auto;
        border-collapse: separate;
        border-spacing: 0;
    }

        /* Column headers */
        .inventory-table thead th {
            background: #1765c1;
            color: #ffffff;
            padding: 17px 18px;
            font-size: 12px;
            font-weight: 700;
            text-align: left;
            line-height: 1.4;
            white-space: nowrap;
            vertical-align: middle;
        }

        /* Table cells */
        .inventory-table tbody td {
            padding: 18px;
            border-bottom: 1px solid #e9eef5;
            vertical-align: middle;
            white-space: normal;
            overflow-wrap: break-word;
        }

        .inventory-table tbody tr:last-child td {
            border-bottom: none;
        }

        .inventory-table tbody tr:hover {
            background: #f8fbff;
        }

        /* Give important columns sufficient space */
        .inventory-table th:nth-child(1),
        .inventory-table td:nth-child(1) {
            min-width: 105px;
        }

        .inventory-table th:nth-child(2),
        .inventory-table td:nth-child(2) {
            min-width: 180px;
        }

        .inventory-table th:nth-child(3),
        .inventory-table td:nth-child(3) {
            min-width: 145px;
        }

        .inventory-table th:nth-child(4),
        .inventory-table td:nth-child(4) {
            min-width: 135px;
        }

        .inventory-table th:nth-child(5),
        .inventory-table td:nth-child(5) {
            min-width: 220px;
        }

        .inventory-table th:nth-child(6),
        .inventory-table td:nth-child(6),
        .inventory-table th:nth-child(7),
        .inventory-table td:nth-child(7),
        .inventory-table th:nth-child(8),
        .inventory-table td:nth-child(8) {
            min-width: 145px;
            text-align: center;
        }

        .inventory-table th:nth-child(9),
        .inventory-table td:nth-child(9) {
            min-width: 105px;
            text-align: center;
        }

        /* Quantity badges */
        .inventory-table .quantity-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 68px;
            min-height: 44px;
            padding: 10px 14px;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 750;
            font-variant-numeric: tabular-nums;
            white-space: nowrap;
        }

        /* Delete button must never split into multiple lines */
        .inventory-table .delete-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            min-width: 80px;
            padding: 9px 10px;
            border: none;
            border-radius: 8px;
            background: transparent;
            color: #64748b;
            font-size: 12px;
            font-weight: 650;
            white-space: nowrap;
            word-break: normal;
            overflow-wrap: normal;
            cursor: pointer;
        }

            .inventory-table .delete-action:hover {
                background: #fff1f2;
                color: #dc2626;
            }

    /* Scrollbar visible on the table container */
    .table-container::-webkit-scrollbar {
        height: 10px;
    }

    .table-container::-webkit-scrollbar-track {
        background: #edf2f7;
        border-radius: 10px;
    }

    .table-container::-webkit-scrollbar-thumb {
        background: #94a3b8;
        border-radius: 10px;
    }

        .table-container::-webkit-scrollbar-thumb:hover {
            background: #64748b;
        }


        .inventory-table th,
        .inventory-table td {
            padding: 14px 12px;
            vertical-align: middle;
        }

        .inventory-table th {
            white-space: normal;
            line-height: 1.4;
            overflow-wrap: anywhere;
        }

        .inventory-table td {
            overflow-wrap: anywhere;
        }

        /* Professional quantity display */
        .inventory-table .quantity-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 58px;
            padding: 9px 12px;
            border-radius: 9px;
            font-size: 14px;
            font-weight: 750;
            font-variant-numeric: tabular-nums;
        }

            .inventory-table .quantity-badge.total {
                background: #eff6ff;
                color: #1d4ed8;
            }

            .inventory-table .quantity-badge.good {
                background: #ecfdf5;
                color: #047857;
            }

            .inventory-table .quantity-badge.bad {
                background: #fff1f2;
                color: #be123c;
            }


        .inventory-table thead {
            background: #f8fafc;
        }

        .inventory-table th {
            padding: 15px 20px;
            text-align: left;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #fff;
            font-weight: 750;
            border-bottom: 1px solid #e9edf3;
            white-space: nowrap;
        }

        .inventory-table td {
            padding: 17px 20px;
            border-bottom: 1px solid #eef1f5;
            vertical-align: middle;
        }

        .inventory-table tbody tr {
            transition: background 0.18s ease;
        }

            .inventory-table tbody tr:hover {
                background: #fafcff;
            }

    .product-image-wrapper {
        width: 58px;
        height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .product-image {
        width: 58px;
        height: 58px;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid #e2e7ef;
    }

    .no-image {
        width: 58px;
        height: 58px;
        border-radius: 12px;
        background: #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .part-number {
        display: inline-block;
        padding: 7px 10px;
        border-radius: 8px;
        background: #f1f5f9;
        color: #334155;
        font-size: 13px;
        font-weight: 700;
        font-family: monospace;
    }

    .item-info {
        display: flex;
        flex-direction: column;
    }

        .item-info strong {
            font-size: 14px;
            color: #202939;
        }

        .item-info span {
            margin-top: 4px;
            font-size: 11px;
            color: #a0a7b4;
        }

    .stock-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 11px;
        border-radius: 9px;
        font-weight: 750;
        font-size: 14px;
    }

        .stock-badge small {
            margin-left: 2px;
            font-size: 10px;
            font-weight: 600;
        }

        .stock-badge.available {
            color: #047857;
            background: #ecfdf5;
        }

        .stock-badge.low {
            color: #c2410c;
            background: #fff7ed;
        }

    .stock-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: currentColor;
    }



    .delete-action {
        border: 0;
        background: transparent;
        color: #94a3b8;
        font-size: 12px;
        font-weight: 650;
        cursor: pointer;
        padding: 8px 10px;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

        .delete-action:hover {
            background: #fff1f2;
            color: #dc2626;
        }

    .hidden {
        display: none;
    }

    .empty-state {
        padding: 70px 20px;
        text-align: center;
    }

    .empty-icon {
        width: 65px;
        height: 65px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f1f5f9;
