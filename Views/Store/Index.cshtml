
@model StoreViewModel

@{
    ViewData["Title"] = "Inventory";
}

@if (TempData["Success"] != null)
{
    <div class="toast-message toast-success">
        <div class="toast-icon">✓</div>
        <div>
            <strong>Success</strong>
            <span>@TempData["Success"]</span>
        </div>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="toast-message toast-error">
        <div class="toast-icon">!</div>
        <div>
            <strong>Error</strong>
            <span>@TempData["Error"]</span>
        </div>
    </div>
}


<div class="inventory-container">

    <div class="inventory-header">

        <div class="header-left">

            <div class="header-icon">
                📦
            </div>

            <div>
                <div class="breadcrumb">
                    Store Management
                    <span>›</span>
                    Inventory
                </div>

                <h1>Inventory</h1>

                <p>
                    Manage stock levels, item information and transaction history
                </p>
            </div>

        </div>


        <div class="header-right">
            <a asp-controller="Store"
               asp-action="AddItem"
               asp-route-brandId="@ViewBag.BrandId"
               class="add-item-btn">

                <span class="plus-icon">+</span>
                Add Item

            </a>
        </div>

    </div>


    <div class="summary-grid">

        <div class="summary-card">

            <div class="summary-content">

                <span class="summary-label">
                    Total Items
                </span>

                <strong class="summary-value">
                    @(Model.Items?.Count() ?? 0)
                </strong>

                <span class="summary-description">
                    Registered inventory items
                </span>

            </div>

            <div class="summary-icon blue">
                📦
            </div>

        </div>


        <div class="summary-card">

            <div class="summary-content">

                <span class="summary-label">
                    Total Stock
                </span>

                <strong class="summary-value">
                    @(Model.Items?.Sum(x => x.Quantity) ?? 0)
                </strong>

                <span class="summary-description">
                    Current available quantity
                </span>

            </div>

            <div class="summary-icon green">
                📊
            </div>

        </div>


        <div class="summary-card">

            <div class="summary-content">

                <span class="summary-label">
                    Low Stock
                </span>

                <strong class="summary-value">
                    @(Model.Items?.Count(x => x.Quantity <= 10) ?? 0)
                </strong>

                <span class="summary-description">
                    Items requiring attention
                </span>

            </div>

            <div class="summary-icon orange">
                ⚠
            </div>

        </div>


        <div class="summary-card">

            <div class="summary-content">

                <span class="summary-label">
                    Transactions
                </span>

                <strong class="summary-value">
                    @(Model.History?.Count() ?? 0)
                </strong>

                <span class="summary-description">
                    Recorded stock movements
                </span>

            </div>

            <div class="summary-icon purple">
                ↔
            </div>

        </div>

    </div>

    <section class="inventory-card">

        <div class="card-header">

            <div>

                <h2>
                    Inventory Items
                </h2>

                <p>
                    View and manage your current stock
                </p>

            </div>


            <div class="search-container">

                <div class="search-form">

                    <span class="search-icon">
                        🔍
                    </span>

                    <input id="inventorySearch"
                           type="text"
                           value="@Model.Search"
                           placeholder="Search by Part Number or Item Name..."
                           autocomplete="off" />

                    <button type="button"
                            id="clearSearch"
                            class="search-clear"
                            title="Clear search"
                            style="display:none;">
                        ×
                    </button>

                </div>

            </div>

        </div>

        <div class="table-container">

            <table class="inventory-table">

                <thead>

                    <tr>

                        <th class="image-column">
                            Product
                        </th>

                        <th>
                            Part Number
                        </th>

                        <th>
                            Item Name
                        </th>

                        <th>
                            Available Stock
                        </th>

                        <th>
                            Stock Update
                        </th>

                        <th>
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model.Items != null && Model.Items.Any())
                    {

                        foreach (var item in Model.Items)
                        {

                            <tr class="inventory-row"
                                data-part-number="@item.PartNumber"
                                data-item-name="@item.ItemName">

                                <td>

                                    <div class="product-image-wrapper">

                                        @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                                        {
                                            <img src="@item.ImagePath"
                                                 class="product-image"
                                                 alt="@item.ItemName" />
                                        }
                                        else
                                        {
                                            <div class="no-image">
                                                📦
                                            </div>
                                        }

                                    </div>

                                </td>

                                <td>

                                    <div class="part-number">

                                        @item.PartNumber

                                    </div>

                                </td>

                                <td>

                                    <div class="item-info">

                                        <strong>
                                            @item.ItemName
                                        </strong>

                                        <span>
                                            Inventory Item
                                        </span>

                                    </div>

                                </td>

                                <td>

                                    @if (item.Quantity <= 10)
                                    {

                                        <span class="stock-badge low">
                                            <span class="stock-dot"></span>
                                            @item.Quantity
                                            <small>Low Stock</small>
                                        </span>

                                    }
                                    else
                                    {

                                        <span class="stock-badge available">
                                            <span class="stock-dot"></span>
                                            @item.Quantity
                                            <small>Available</small>
                                        </span>

                                    }

                                </td>



                                <td>

                                    <form asp-action="Update"
                                          method="post"
                                          class="stock-update-form">

                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        <input class="stock-input"
                                               name="quantity"
                                               type="number"
                                               min="1"
                                               placeholder="Qty"
                                               required />

                                        <button name="actionType"
                                                value="in"
                                                class="stock-in"
                                                type="submit"
                                                title="Add stock">

                                            <span>+</span>
                                            In

                                        </button>

                                        <button name="actionType"
                                                value="out"
                                                class="stock-out"
                                                type="submit"
                                                title="Remove stock">

                                            <span>−</span>
                                            Out

                                        </button>

                                    </form>

                                </td>


                                <td>

                                    <button class="delete-action"
                                            type="button"
                                            onclick="confirmDelete(@item.Id, this)">

                                        🗑
                                        <span>Delete</span>

                                    </button>


                                    <form id="delete-@item.Id"
                                          asp-action="Delete"
                                          method="post"
                                          class="hidden">

                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                    </form>

                                </td>

                            </tr>

                        }

                        <tr id="noSearchResults" style="display:none;">
                            <td colspan="6">
                                <div class="empty-state">

                                    <div class="empty-icon">
                                        🔍
                                    </div>

                                    <h3>
                                        No matching items found
                                    </h3>

                                    <p>
                                        No Part Number or Item Name matches your search.
                                    </p>

                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {

                        <tr>

                            <td colspan="6">

                                <div class="empty-state">

                                    <div class="empty-icon">
                                        📦
                                    </div>

                                    <h3>
                                        No inventory items found
                                    </h3>

                                    <p>
                                        There are no items matching your search.
                                    </p>

                                    @if (!string.IsNullOrEmpty(Model.Search))
                                    {
                                        <a asp-action="Index"
                                           class="empty-btn">

                                            Clear Search

                                        </a>
                                    }

                                </div>

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

    </section>

    <section class="reports-card">

        <!-- REPORT HEADER -->
        <div class="reports-header">

            <div class="reports-icon">
                📈
            </div>

            <div class="reports-header-text">
                <h2>Export & Reports</h2>

                <p>
                    Download inventory and stock movement reports
                </p>
            </div>

        </div>


        <!-- REPORT OPTIONS -->
        <div class="reports-content">


            <!-- ================= CURRENT STOCK ================= -->
            <a class="report-option"
               asp-action="ExportCurrentStock"
               asp-route-brandId="@ViewBag.BrandId">

                <div class="report-option-icon">
                    📥
                </div>

                <div class="report-option-text">

                    <strong>
                        Download Current Stock
                    </strong>

                    <span>
                        Export available inventory
                    </span>

                </div>

            </a>



            <!-- ================= MONTHLY REPORT LABEL ================= -->
            <div class="monthly-label">

                <div class="monthly-icon">
                    🗓️
                </div>

                <div class="monthly-label-text">

                    <strong>Monthly</strong>
                    <strong>Stock</strong>
                    <strong>Report</strong>

                </div>

            </div>



            <!-- ================= MONTHLY REPORT FORM ================= -->
            <form asp-action="MonthlyReport"
                  method="get"
                  class="monthly-report-form">


                <!-- MONTH -->
                <select name="month"
                        class="report-select">

                    @for (int m = 1; m <= 12; m++)
                    {
                        var monthName =
                        System.Globalization.CultureInfo
                        .CurrentCulture
                        .DateTimeFormat
                        .GetMonthName(m);

                        <option value="@m"
                                selected="@(m == DateTime.Now.Month)">
                            @monthName
                        </option>
                    }

                </select>



                <!-- YEAR -->
                <select name="year"
                        class="report-select">

                    @for (int y = DateTime.Now.Year - 2;
                                        y <= DateTime.Now.Year + 2;
                                        y++)
                    {
                        <option value="@y"
                                selected="@(y == DateTime.Now.Year)">
                            @y
                        </option>
                    }

                </select>



                <!-- DOWNLOAD -->
                <button type="submit"
                        class="download-report-btn">

                    <span class="download-icon">
                        ↓
                    </span>

                    <span class="download-text">
                        Download<br />
                        Report
                    </span>

                </button>

            </form>

        </div>

    </section>


    <section class="history-card">

        <div class="history-header">

            <div>
                <h2>
                    Transaction History
                </h2>

                <p>
                    Recent inventory movements
                </p>
            </div>

            <span class="history-count" id="historyCount">
                @(Model.History?.Count() ?? 0)
                Transactions
            </span>

        </div>


        @if (Model.History != null && Model.History.Any())
        {

            <div class="history-list" id="historyList">

                @foreach (var row in Model.History)
                {

                    <div class="history-item">

                        <div class="history-icon @(row.Change >= 0 ? "history-in" : "history-out")">

                            @(row.Change >= 0 ? "+" : "−")

                        </div>


                        <div class="history-details">

                            <strong>
                                @(row.Change >= 0
                                                        ? "Stock Added"
                                                        : "Stock Removed")
                    </strong>

                            <span>
                                @row.TransactionDate.ToString("dd MMM yyyy, HH:mm:ss")
                            </span>

                        </div>


                        <div class="history-quantity @(row.Change >= 0 ? "positive" : "negative")">

                            @(row.Change >= 0 ? "+" : "")
                            @row.Change q

                        </div>


                        <div class="history-balance">

                            <span>
                                Balance
                            </span>

                            <strong>
                                @row.Balance
                            </strong>

                        </div>

                    </div>

                        }

            </div>


            <!-- Pagination -->
            <div class="history-pagination" id="historyPagination">

                <button type="button"
                        class="pagination-btn pagination-prev"
                        id="historyPrev">
                    ‹
                </button>

                <div class="pagination-pages" id="historyPages">
                </div>

                <button type="button"
                        class="pagination-btn pagination-next"
                        id="historyNext">
                    ›
                </button>

            </div>

        }
        else
        {

            <div class="history-empty">

                <div>
                    ↔
                </div>

                <h3>
                    No transactions yet
                </h3>

                <p>
                    Stock movements will appear here.
                </p>

            </div>

        }

    </section>

</div>


<style>

    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        padding: 0;
    }

    body {
        background: #f5f7fb;
        color: #172033;
    }

    .inventory-container {
        width: 100%;
        max-width: 1600px;
        margin: 0 auto;
        padding: 32px;
    }

    .inventory-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .header-right {
        display: flex;
        align-items: center;
    }

    .header-icon {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        color: #ffffff;
        font-size: 27px;
        box-shadow: 0 10px 25px rgba(37, 99, 235, 0.22);
    }

    .breadcrumb {
        margin-bottom: 5px;
        font-size: 13px;
        color: #8a94a6;
    }

        .breadcrumb span {
            padding: 0 6px;
        }

    .inventory-header h1 {
        margin: 0;
        font-size: 32px;
        font-weight: 800;
        letter-spacing: -0.5px;
    }

    .inventory-header p {
        margin: 5px 0 0;
        color: #7b8494;
        font-size: 14px;
    }

    .add-item-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 13px 20px;
        border-radius: 12px;
        text-decoration: none;
        color: #ffffff;
        background: #2563eb;
        font-weight: 700;
        box-shadow: 0 8px 20px rgba(37, 99, 235, 0.22);
        transition: all 0.2s ease;
    }

        .add-item-btn:hover {
            color: #ffffff;
            transform: translateY(-2px);
            background: #1d4ed8;
        }

    .plus-icon {
        font-size: 21px;
        line-height: 1;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 25px;
    }

    .summary-card {
        background: #ffffff;
        border: 1px solid #e8ecf3;
        border-radius: 18px;
        padding: 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 5px 20px rgba(15, 23, 42, 0.04);
        transition: all 0.2s ease;
    }

        .summary-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(15, 23, 42, 0.07);
        }

    .summary-content {
        display: flex;
        flex-direction: column;
    }

    .summary-label {
        color: #7b8494;
        font-size: 13px;
        font-weight: 600;
    }

    .summary-value {
        margin-top: 5px;
        font-size: 29px;
        font-weight: 800;
        color: #172033;
    }

    .summary-description {
        margin-top: 4px;
        font-size: 12px;
        color: #a0a7b4;
    }

    .summary-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
    }

        .summary-icon.blue {
            background: #eff6ff;
        }

        .summary-icon.green {
            background: #ecfdf5;
        }

        .summary-icon.orange {
            background: #fff7ed;
        }

        .summary-icon.purple {
            background: #f5f3ff;
        }

    .inventory-card {
        background: #ffffff;
        border: 1px solid #e7ebf2;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(15, 23, 42, 0.05);
    }

    .card-header {
        padding: 24px 26px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #edf0f5;
    }

        .card-header h2 {
            margin: 0;
            font-size: 19px;
            font-weight: 750;
        }

        .card-header p {
            margin: 5px 0 0;
            color: #8992a2;
            font-size: 13px;
        }

    .search-container {
        width: auto;
    }

    .search-form {
        height: 44px;
        width: 390px;
        display: flex;
        align-items: center;
        background: #f7f9fc;
        border: 1px solid #e1e6ee;
        border-radius: 11px;
        overflow: hidden;
        transition: all 0.2s ease;
    }

        .search-form:focus-within {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
        }

    .search-icon {
        padding-left: 13px;
        font-size: 14px;
    }

    .search-form input {
        flex: 1;
        height: 100%;
        border: 0;
        outline: 0;
        background: transparent;
        padding: 0 10px;
        font-size: 13px;
        color: #1e293b;
        margin-top: 3px;
    }

        .search-form input::placeholder {
            color: #9aa3b2;
        }

    .search-form button {
        height: 100%;
        border: 0;
        padding: 0 17px;
        background: #172033;
        color: #ffffff;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s ease;
    }

        .search-form button:hover {
            background: #2563eb;
        }

    .search-clear {
        color: #8992a2;
        text-decoration: none;
        font-size: 20px;
        padding: 0 8px;
        line-height: 1;
    }

        .search-clear:hover {
            color: #ef4444;
        }

    .table-container {
        width: 100%;
        overflow-x: auto;
    }

    .inventory-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 1050px;
    }

        .inventory-table thead {
            background: #f8fafc;
        }

        .inventory-table th {
            padding: 15px 20px;
            text-align: left;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            color: #fff;
            font-weight: 750;
            border-bottom: 1px solid #e9edf3;
            white-space: nowrap;
        }

        .inventory-table td {
            padding: 17px 20px;
            border-bottom: 1px solid #eef1f5;
            vertical-align: middle;
        }

        .inventory-table tbody tr {
            transition: background 0.18s ease;
        }

            .inventory-table tbody tr:hover {
                background: #fafcff;
            }

    .product-image-wrapper {
        width: 58px;
        height: 58px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .product-image {
        width: 58px;
        height: 58px;
        object-fit: cover;
        border-radius: 12px;
        border: 1px solid #e2e7ef;
    }

    .no-image {
        width: 58px;
        height: 58px;
        border-radius: 12px;
        background: #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .part-number {
        display: inline-block;
        padding: 7px 10px;
        border-radius: 8px;
        background: #f1f5f9;
        color: #334155;
        font-size: 13px;
        font-weight: 700;
        font-family: monospace;
    }

    .item-info {
        display: flex;
        flex-direction: column;
    }

        .item-info strong {
            font-size: 14px;
            color: #202939;
        }

        .item-info span {
            margin-top: 4px;
            font-size: 11px;
            color: #a0a7b4;
        }

    .stock-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 11px;
        border-radius: 9px;
        font-weight: 750;
        font-size: 14px;
    }

        .stock-badge small {
            margin-left: 2px;
            font-size: 10px;
            font-weight: 600;
        }

        .stock-badge.available {
            color: #047857;
            background: #ecfdf5;
        }

        .stock-badge.low {
            color: #c2410c;
            background: #fff7ed;
        }

    .stock-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: currentColor;
    }

    .stock-update-form {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .stock-input {
        width: 75px;
        height: 36px;
        border: 1px solid #dbe1e9;
        border-radius: 8px;
        padding: 0 9px;
        outline: none;
        font-size: 12px;
        background: #ffffff;
    }

        .stock-input:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
        }

    .stock-in,
    .stock-out {
        height: 36px;
        border: 0;
        padding: 0 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .stock-in {
        background: #ecfdf5;
        color: #047857;
    }

    .stock-out {
        background: #fff1f2;
        color: #be123c;
    }

    .stock-in:hover {
        background: #d1fae5;
    }

    .stock-out:hover {
        background: #ffe4e6;
    }

    .delete-action {
        border: 0;
        background: transparent;
        color: #94a3b8;
        font-size: 12px;
        font-weight: 650;
        cursor: pointer;
        padding: 8px 10px;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

        .delete-action:hover {
            background: #fff1f2;
            color: #dc2626;
        }

    .hidden {
        display: none;
    }

    .empty-state {
        padding: 70px 20px;
        text-align: center;
    }

    .empty-icon {
        width: 65px;
        height: 65px;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f1f5f9;
        border-radius: 18px;
        font-size: 27px;
    }

    .empty-state h3 {
        margin: 18px 0 6px;
        font-size: 17px;
    }

    .empty-state p {
        margin: 0;
        color: #8a94a6;
        font-size: 13px;
    }

    .empty-btn {
        display: inline-block;
        margin-top: 18px;
        padding: 9px 16px;
        background: #2563eb;
        color: #ffffff;
        border-radius: 8px;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
        transition: background 0.2s ease;
    }

        .empty-btn:hover {
            background: #1d4ed8;
            color: #ffffff;
        }

    .reports-card {
        width: 100%;
        margin-top: 25px;
