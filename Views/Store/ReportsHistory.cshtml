@section Scripts {

    <script>

        function confirmDelete(id, btn) {

            if (btn.dataset.confirmed === 'true') {

                document.getElementById('delete-' + id).submit();

                return;
            }

            btn.dataset.confirmed = 'true';

            btn.innerHTML = '⚠ Confirm Delete';

            btn.style.backgroundColor = '#fee2e2';
            btn.style.color = '#dc2626';

            setTimeout(function () {

                btn.dataset.confirmed = '';

                btn.innerHTML = '🗑 Delete';

                btn.style.backgroundColor = '';
                btn.style.color = '';

            }, 3000);

        }

        setTimeout(function () {

            const toast = document.querySelector('.toast-message');

            if (toast) {

                toast.style.opacity = '0';

                toast.style.transform = 'translateX(30px)';

                toast.style.transition = '.4s';

                setTimeout(function () {

                    toast.remove();

                }, 400);

            }

        }, 4000);

        document.addEventListener("DOMContentLoaded", function () {

            const searchInput =
                document.getElementById("inventorySearch");

            const clearButton =
                document.getElementById("clearSearch");

            const rows =
                document.querySelectorAll(".inventory-row");

            const noSearchResults =
                document.getElementById("noSearchResults");


            if (!searchInput) {
                return;
            }


            function filterInventory() {

                const searchText =
                    searchInput.value
                        .trim()
                        .toLowerCase();


                let visibleCount = 0;


                rows.forEach(function (row) {

                    const partNumber =
                        (
                            row.getAttribute("data-part-number") || ""
                        ).toLowerCase();


                    const itemName =
                        (
                            row.getAttribute("data-item-name") || ""
                        ).toLowerCase();


                    // Match Part Number OR Item Name
                    const matches =
                        partNumber.includes(searchText) ||
                        itemName.includes(searchText);


                    if (matches) {

                        row.style.display = "";

                        visibleCount++;

                    }
                    else {

                        row.style.display = "none";

                    }

                });

                if (searchText.length > 0) {

                    clearButton.style.display = "block";

                }
                else {

                    clearButton.style.display = "none";

                }

                if (noSearchResults) {

                    if (
                        visibleCount === 0 &&
                        searchText.length > 0
                    ) {

                        noSearchResults.style.display = "table-row";

                    }
                    else {

                        noSearchResults.style.display = "none";

                    }

                }

            }

            searchInput.addEventListener(
                "input",
                function () {

                    filterInventory();

                }
            );

            if (clearButton) {

                clearButton.addEventListener(
                    "click",
                    function () {

                        searchInput.value = "";

                        filterInventory();

                        searchInput.focus();

                    }
                );

            }

            filterInventory();

        });

        document.addEventListener("DOMContentLoaded", function () {

            const historyList =
                document.getElementById("historyList");

            const pagination =
                document.getElementById("historyPagination");

            const pagesContainer =
                document.getElementById("historyPages");

            const previousButton =
                document.getElementById("historyPrev");

            const nextButton =
                document.getElementById("historyNext");


            if (!historyList || !pagination) {
                return;
            }


            const historyItems =
                Array.from(
                    historyList.querySelectorAll(".history-item")
                );


            const recordsPerPage = 10;

            const totalRecords =
                historyItems.length;

            const totalPages =
                Math.ceil(totalRecords / recordsPerPage);


            let currentPage = 1;

            if (totalPages <= 1) {

                pagination.style.display = "none";

                historyItems.forEach(function (item) {
                    item.classList.remove("history-hidden");
                });

                return;
            }

            function showPage(page) {

                currentPage = page;


                const startIndex =
                    (currentPage - 1) * recordsPerPage;


                const endIndex =
                    startIndex + recordsPerPage;


                historyItems.forEach(function (item, index) {

                    if (
                        index >= startIndex &&
                        index < endIndex
                    ) {

                        item.classList.remove("history-hidden");

                    }
                    else {

                        item.classList.add("history-hidden");

                    }

                });


                renderPagination();

                previousButton.disabled =
                    currentPage === 1;

                nextButton.disabled =
                    currentPage === totalPages;

                historyList.scrollIntoView({
                    behavior: "smooth",
                    block: "start"
                });

            }

            function renderPagination() {

                pagesContainer.innerHTML = "";

                if (totalPages <= 7) {

                    for (
                        let page = 1;
                        page <= totalPages;
                        page++
                    ) {

                        createPageButton(page);

                    }

                    return;
                }

                createPageButton(1);


                if (currentPage <= 4) {

                    createPageButton(2);
                    createPageButton(3);
                    createPageButton(4);
                    createPageButton(5);

                    createDots();

                    createPageButton(totalPages);

                }

                else if (
                    currentPage >= totalPages - 3
                ) {

                    createDots();

                    createPageButton(totalPages - 4);
                    createPageButton(totalPages - 3);
                    createPageButton(totalPages - 2);
                    createPageButton(totalPages - 1);
                    createPageButton(totalPages);

                }

                else {

                    createDots();

                    createPageButton(
                        currentPage - 1
                    );

                    createPageButton(
                        currentPage
                    );

                    createPageButton(
                        currentPage + 1
                    );

                    createDots();

                    createPageButton(totalPages);

                }

            }

            function createPageButton(page) {

                const button =
                    document.createElement("button");


                button.type = "button";

                button.className =
                    "pagination-number";


                button.textContent =
                    page;


                if (page === currentPage) {

                    button.classList.add("active");

                }


                button.addEventListener(
                    "click",
                    function () {

                        showPage(page);

                    }
                );


                pagesContainer.appendChild(button);

            }

            function createDots() {

                const dots =
                    document.createElement("span");


                dots.className =
                    "pagination-dots";


                dots.textContent =
                    "…";


                pagesContainer.appendChild(dots);

            }

            previousButton.addEventListener(
                "click",
                function () {

                    if (currentPage > 1) {

                        showPage(
                            currentPage - 1
                        );

                    }

                }
            );

            nextButton.addEventListener(
                "click",
                function () {

                    if (
                        currentPage < totalPages
                    ) {

                        showPage(
                            currentPage + 1
                        );

                    }

                }
            );

            showPage(1);

        });

    </script>

}